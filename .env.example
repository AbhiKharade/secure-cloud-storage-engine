# ==============================================================================
# SPPU Cloud Computing Laboratory - Supabase Storage S3 Configuration
# ==============================================================================
# In Supabase: Project Settings -> Storage -> S3 Access Keys -> Generate Keys
# Endpoint format: https://<project-ref>.storage.supabase.co/storage/v1/s3

AWS_ACCESS_KEY_ID=your_supabase_s3_access_key_id
AWS_SECRET_ACCESS_KEY=your_supabase_s3_secret_key
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET_NAME=sppu-cloud-secure-storage
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3

# Storage Mode: "supabase" (or "mock" for local offline testing without credentials)
STORAGE_MODE=supabase

# Default chunk size in bytes (512 KB = 524288)
CHUNK_SIZE_BYTES=524288
